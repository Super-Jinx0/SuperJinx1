# Read-only root: this file is turned into /tmp/nginx/nginx.conf at start (placeholders: __PORT__ __DATA__ __RUN__ __TMP__)
worker_processes 1;
worker_rlimit_nofile 16384;
pid __TMP__/nginx.pid;
events { worker_connections 8192; multi_accept on; }
http {
  access_log off;
  error_log /dev/stdout warn;
  # temp folders must be on the writable /tmp (default ones live on the read-only root)
  client_body_temp_path __TMP__/body;
  proxy_temp_path __TMP__/proxy;
  fastcgi_temp_path __TMP__/fastcgi;
  uwsgi_temp_path __TMP__/uwsgi;
  scgi_temp_path __TMP__/scgi;
  sendfile on; tcp_nopush on; tcp_nodelay on; keepalive_timeout 75s; keepalive_requests 10000;
  server_tokens off; reset_timedout_connection on; types_hash_max_size 2048;
  client_max_body_size 0;
  map $http_upgrade $conn_upgrade { default upgrade; '' ''; }

  # learn the public domain from real visits (so configs are never empty, even before PUBLIC_DOMAIN is set)
  log_format jxhost '$host';
  map $host $jx_learn { default 1; "~^(localhost|127\.|[0-9.]+$)" 0; }

  # performance: reuse connections to the panel, compress panel assets
  upstream panel { server 127.0.0.1:8000; keepalive 16; }
  gzip on; gzip_comp_level 5; gzip_min_length 1024; gzip_proxied any;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  # ---- fast "ping": speed-test requests of the apps are answered here (the core sends them to 8099) ----
  server {
    listen 127.0.0.1:8099 default_server;
    location = /generate_204 { return 204; }
    location / { return 301 https://$host$request_uri; }
  }
  server {
    listen 127.0.0.1:8099;
    server_name cp.cloudflare.com;
    location / { return 204; }
  }

  server {
    listen __PORT__ default_server;
    #__EXTRA_LISTEN__

    location = /healthz { return 200 "ok"; }

    # ---- bare domain: a "your panel is getting ready" page; it opens the panel by itself when setup is done ----
    location = / { root /etc/nginx/jinx; try_files /jinx-home.html =404; default_type text/html; charset utf-8; add_header Cache-Control "no-store" always; }

    # ---- friendly page instead of "502 Bad Gateway" while the panel (re)starts; status code is kept,
    #      so subscription apps never mistake it for an empty subscription ----
    error_page 502 503 504 /jinx-wait.html;
    location = /jinx-wait.html { root /etc/nginx/jinx; internal; add_header Cache-Control "no-store" always; add_header Retry-After "5" always; }

    # ---- 5 config paths: random per install, generated by genpaths.py on first boot ----
    include __DATA__/inbounds.inc;

    # ---- guard bots status page (8 bots, JSON) ----
    location = /jx-status {
      proxy_pass http://127.0.0.1:8101;
      proxy_connect_timeout 3s;
      add_header Cache-Control "no-store";
    }

    # ---- clean IP subscription: /sub/<token>/jx-ip (the normal link is never touched) ----
    location ~ ^/sub/([^/]+)/jx-ip/?$ {
      proxy_pass http://127.0.0.1:8100/jinx-sub/$1;
      proxy_set_header User-Agent $http_user_agent;
      proxy_read_timeout 60s;
      add_header Cache-Control "no-store" always;
    }

    # ---- owner key page (get a 5-minute key to change the owner password) ----
    location ^~ /jinx/ {
      proxy_pass http://127.0.0.1:8100;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header Host $host;
      client_max_body_size 1m;
    }

    # ---- Super JinX dashboard skin + menu filter + owner key ----
    location = /jinx-ui.js { alias /etc/nginx/jinx-ui.js; default_type application/javascript; add_header Cache-Control "no-cache"; }
    location /dashboard {
      proxy_pass http://panel;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Connection "";
      proxy_set_header Accept-Encoding "";
      sub_filter_types text/html;
      sub_filter_once on;
      sub_filter '</head>' '<script src="/jinx-ui.js" defer></script></head>';
      access_log __RUN__/host.log jxhost if=$jx_learn;
    }

    # ---- panel / api / subscription ----
    location / {
      proxy_pass http://panel;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $conn_upgrade;
      proxy_read_timeout 300s;
      access_log __RUN__/host.log jxhost if=$jx_learn;
    }
  }
}
